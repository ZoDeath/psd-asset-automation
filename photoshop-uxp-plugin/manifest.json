{
  "manifestVersion": 5,
  "id": "com.photoshopai.psdinspector",
  "name": "RHV Art Asset Automation",
  "version": "0.2.0",
  "main": "index.html",
  "host": [{ "app": "PS", "minVersion": "25.0.0" }],
